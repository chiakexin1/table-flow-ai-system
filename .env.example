# TableFlow AI – Environment Variables

# Supabase public (anon) credentials – required for authentication and data access.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Ollama configuration – optional if AI Advisor is not needed.
# Default base URL points to a locally‑running Ollama instance.
VITE_OLLAMA_BASE_URL=http://localhost:11434
# Name of the model you wish to use (e.g., llama3:8b). Leave empty to select from UI.
VITE_OLLAMA_MODEL=